OPENAI_API_KEY=
MODEL_NAME="gpt-realtime"

# Conversation backend: "openai" (default, OpenAI Realtime) or "gemini" (Gemini Live)
HANDLER_TYPE="openai"

# === Gemini backend (used when HANDLER_TYPE=gemini, and for the storyteller +
#     memory consolidation regardless of HANDLER_TYPE). Pick ONE auth path: ===
#
#  A) Vertex AI — enterprise/GA, billed to GCP so GCP credits apply.
#       GOOGLE_GENAI_USE_VERTEXAI=true
#       GOOGLE_CLOUD_PROJECT=<your-gcp-project>   # needs: gcloud auth application-default login
#       GEMINI_LIVE_MODEL_NAME="gemini-live-2.5-flash-native-audio"
#     NOTE: Vertex only has the 2.5 native-audio Live model — Gemini 3.x Flash
#     Live is NOT on Vertex yet.
#
#  B) AI Studio — Gemini Developer API; the ONLY place with Gemini 3.1 Flash Live.
#       GOOGLE_GENAI_USE_VERTEXAI=          # leave empty/false
#       GEMINI_API_KEY=<your-aistudio-key>  # set below
#       GEMINI_LIVE_MODEL_NAME="gemini-3.1-flash-live-preview"
#     NOTE: GCP credits do NOT apply to AI Studio (free tier, or prepay). The free
#     tier caps audio sessions at 15 min (the app auto-reconnects) and MAY use your
#     conversations to improve Google's models — avoid it for children's data.
#
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION="us-central1"   # Vertex Live API is regional; do NOT use "global"
GEMINI_LIVE_MODEL_NAME="gemini-live-2.5-flash-native-audio"
# Gemini Live voice (Leda, Puck, Kore, Aoede, Charon, Fenrir, Orus, Zephyr…)
GEMINI_VOICE="Leda"
# End-of-turn detection for Gemini Live. Kids speak slowly with pauses, so the
# server waits this long (ms) of silence before deciding the child finished —
# raise if it cuts them off mid-sentence ("等一下" answered as "等" then "一下"),
# lower if the robot is slow to reply. PREFIX keeps audio before speech onset so
# the first word isn't clipped. Barge-in (interrupting the robot) is unaffected.
GEMINI_VAD_SILENCE_MS="900"
GEMINI_VAD_PREFIX_MS="300"
# Barge-in (interrupting the robot mid-speech) works out of the box via the
# server's own VAD — talk over the robot and it stops. Only enable this extra
# client-side fallback if your robot's server VAD is too insensitive to catch
# you: it stops playback locally when the mic hears sustained speech over the
# robot. Off by default (set 1 to enable). Needs echo cancellation, or it can
# hear the robot's own voice and interrupt itself.
# BARGE_IN_LEVEL = mic loudness threshold 0..1 (raise if it self-interrupts,
# lower if it doesn't catch you).
BARGE_IN_LOCAL=
BARGE_IN_LEVEL="0.06"

# Local vision model (only used with --local-vision CLI flag)
# By default, vision is handled by gpt-realtime when the camera tool is used
LOCAL_VISION_MODEL=HuggingFaceTB/SmolVLM2-2.2B-Instruct

# Cache for local VLM (only used with --local-vision CLI flag)
HF_HOME=./cache

# Hugging Face token for accessing datasets/models
HF_TOKEN=

# Tavily API key for web search tool (optional, get one at https://tavily.com)
TAVILY_API_KEY=

# Gemini AI Studio key. Powers the storyteller + memory tools, and the Gemini Live
# voice backend when using AI Studio (option B above, e.g. Flash 3.1 Live).
# Get one at https://aistudio.google.com  (not needed if using Vertex AI / option A)
GEMINI_API_KEY=

# To select a specific profile with custom instructions and tools, to be placed in profiles/<myprofile>/__init__.py
REACHY_MINI_CUSTOM_PROFILE="example"

# Slow the robot's speech for young children (pitch-preserving WSOLA time-stretch).
# Default 1.0 (off). Set e.g. 1.4 to try a slowdown (under investigation: may have no
# audible effect on some robot audio backends). Range [1.0, 2.5].
SPEECH_SLOWDOWN="1.0"

# Storyteller: seconds to wait after a page's narration finishes before auto-turning
# the page. Raise if pages turn before the reading is done; lower for a snappier pace.
STORY_PAGE_TURN_BUFFER_S="1.0"

# Where generated/curated story & read-along books are stored. Default ~/.reachy_mini/books/
# STORY_BOOKS_DIR=